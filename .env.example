# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public account creation should stay disabled in production. Create users in
# Supabase Auth, then assign their role in public.profiles.
NEXT_PUBLIC_SIGNUP_ENABLED=false

# Portal mode: "hestia" (default) or "brokerage" for real estate brokerages
# NEXT_PUBLIC_PORTAL_MODE=brokerage

# MCP Server
HESTIA_DIRECTIVES_PATH=./directives

# Integration secrets (add when you connect tools, e.g. SMARTLEAD_API_KEY=...)
